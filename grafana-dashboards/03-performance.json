   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "efifgp8jvgj5sf"
     },
     "query": "from(bucket: \"midnight_rider\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"navigation.position\")\n  // sans ce filtre, la carte tracerait aussi les cibles AIS (source N2K.0)\n  |> filter(fn: (r) => r.self == \"true\")\n  |> filter(fn: (r) => r.source == \"N2K.2\")\n  |> filter(fn: (r) => r._field == \"lat\" or r._field == \"lon\")\n  // v.windowPeriod : le pas suit la plage affichee, borne en bas a 5 s par\n  // l intervalle minimum du panneau. On reste sous maxDataPoints = 3000,\n  // donc plus de troncature a 9331 lignes.\n  // createEmpty: true : une fenetre sans position produit une ligne nulle,\n  // qui doit casser le trace au lieu de relier deux bords.\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: true)\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"lat\", \"lon\"])"
    }
   ],
   "title": "Trace du bateau (N2K.2, 1 point / 5 s)",
   "type": "geomap",
   "maxDataPoints": 3000,
   "interval": "5s"
  }
