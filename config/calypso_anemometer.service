[Unit]
Description=Calypso UP10 Anemometer — BLE to Signal K
After=network.target bluetooth.target
Requires=bluetooth.target

[Service]
Type=simple
User=aneto
WorkingDirectory=/home/aneto/midnightrider-navigation
EnvironmentFile=/home/aneto/midnightrider-navigation/.env

# Kill any zombie calypso-anemometer before starting (prevents BLE conflict)
ExecStartPre=/bin/bash -c 'pkill -SIGTERM -f calypso-anemometer 2>/dev/null; sleep 3; pkill -SIGKILL -f calypso-anemometer 2>/dev/null; sleep 1; true'

# Direct to SK port 4123 — no proxy needed (compass off = no sentinel data)
ExecStart=/home/aneto/.local/bin/calypso-anemometer read --subscribe \
 --ble-address ${CALYPSO_BLE_ADDRESS} \
 --ble-connect-timeout 30 \
 --ble-discovery-timeout 15 \
 --rate hz_1 \
 --target udp+signalk+delta://localhost:4123

# Release BLE adapter cleanly on stop
ExecStopPost=/bin/bash -c 'pkill -SIGKILL -f calypso-anemometer 2>/dev/null; hciconfig hci0 down 2>/dev/null; sleep 1; hciconfig hci0 up 2>/dev/null; true'

Restart=on-failure
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=calypso-anemometer

[Install]
WantedBy=multi-user.target
