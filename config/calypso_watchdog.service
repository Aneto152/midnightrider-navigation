[Unit]
Description=Calypso UP10 BLE Watchdog
After=calypso_anemometer.service
Wants=calypso_anemometer.service

[Service]
Type=simple
User=aneto
WorkingDirectory=/home/aneto/midnightrider-navigation
EnvironmentFile=/home/aneto/midnightrider-navigation/.env
ExecStartPre=/bin/rm -f /tmp/calypso_watchdog.pid
ExecStart=/usr/bin/python3 /home/aneto/midnightrider-navigation/ble/calypso_watchdog.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=calypso-watchdog

[Install]
WantedBy=multi-user.target
