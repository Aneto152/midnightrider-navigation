[Unit]
Description=Midnight Rider Navigation Portal (port 8888)
After=network.target

[Service]
Type=simple
User=aneto
WorkingDirectory=/home/aneto/.openclaw/workspace/portal
# Using custom server.py
ExecStart=/usr/bin/python3 /home/aneto/.openclaw/workspace/portal/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
