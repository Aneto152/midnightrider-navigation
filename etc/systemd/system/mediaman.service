[Unit]
Description=Midnight Rider MediaMan — Telegram Race Reporter (one-shot)
Documentation=file:///home/aneto/midnightrider-navigation/mediaman/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/aneto/midnightrider-navigation

# State and logs directories (systemd auto-creation)
StateDirectory=mediaman
LogsDirectory=mediaman
RuntimeDirectory=mediaman

# Execute the mediaman orchestration
ExecStart=/usr/bin/python3 -m mediaman.mediaman

# User/group
User=aneto
Group=aneto

# Environment configuration
# Must be explicitly set for production; defaults to safe test mode
EnvironmentFile=-/etc/mediaman/mediaman.env
Environment="DRY_RUN=true"
Environment="MEDIAMAN_CONTENT_PROVIDER=test"
Environment="MEDIAMAN_PRODUCTION_MODE=false"

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# H5D-PROTECTHOME
# ProtectHome valait "yes" alors que WorkingDirectory est
# /home/aneto/midnightrider-navigation et que seul le sous-dossier logs
# figurait dans ReadWritePaths. Sous ProtectHome=yes, systemd remplace /home
# par un tmpfs vide dans l espace de noms de l unite : le repertoire de
# travail n existe donc pas pour le processus et l unite echoue AVANT d avoir
# atteint son ExecStart. L unite etant desactivee, personne ne l avait jamais
# vu.
# Mesure du 2026-09-17, portee systemd-run transitoire reproduisant l unite
# propriete par propriete : "yes" echoue, "no" passe, et retirer
# ProtectSystem ou ReadWritePaths ne change pas ce verdict.
# Le depot vit reellement sous /home. Tout le reste demeure en lecture seule
# grace a ProtectSystem=strict.
ProtectHome=no
ReadWritePaths=/var/lib/mediaman /var/log/mediaman /home/aneto/midnightrider-navigation/logs

# Resource limits
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
