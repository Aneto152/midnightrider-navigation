[Unit]
Description=Midnight Rider MediaMan — Telegram Race Reporter (one-shot)
Documentation=file:///home/aneto/midnightrider-navigation/mediaman/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/aneto/midnightrider-navigation
ExecStart=/usr/bin/python3 -m mediaman.mediaman
User=aneto
Group=aneto

# Environment variable configuration (systemd can source from file)
EnvironmentFile=-/etc/mediaman/mediaman.env
# Production: require explicit provider and DRY_RUN=false
# Default to test mode to prevent silent test content publishing
Environment="DRY_RUN=true"
Environment="MEDIAMAN_CONTENT_PROVIDER=test"
# Must be explicitly set to non-test for production
Environment="MEDIAMAN_PRODUCTION_MODE=false"

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mediaman /var/log/mediaman

# Resource limits
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
